CXX_STD = CXX17
PKG_CPPFLAGS = -D_HAS_AUTO_PTR_ETC=0
# The Eigen tensor/sparse and Boost odeint templates produce object files with
# more than 32768 COFF sections, in particular in debug builds (-O0 -g, as used
# by devtools::load_all()): 'file too big' / 'too many sections'.
PKG_CXXFLAGS = -Wa,-mbig-obj
PKG_FFLAGS = -std=f2018
PKG_LIBS += $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" -e "RcppParallel::RcppParallelLibs()")
